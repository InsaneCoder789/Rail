DATABASE_URL=postgresql://localhost:5432/YOUR_DATABASE
RAIL_SIGNING_SECRET=SUPERSECRETPASSWD
JWT_SECRET=ANOTHER_SUPERSECRETPASSWD
RAIL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
RAIL_API_KEY_SCOPES=offline_tokens:issue,sync:write
# Optional JSON target registry; operator references only, never provider credentials or card data.
# Empty disables new external proposals. See docs/PROVIDER_PAYMENTS.md for the schema and rollout limits.
RAIL_PROVIDER_TARGETS=
# Local simulator execution only: also requires RAIL_DEMO_MODE=true and NODE_ENV != production.
RAIL_PROVIDER_SIMULATOR=false
# Test callback inbox only; no charge permission. Requires non-production demo mode.
RAIL_STRIPE_TEST_WEBHOOKS=false
RAIL_STRIPE_ACCOUNT_ID=
RAIL_STRIPE_WEBHOOK_SECRET=
RAIL_TRUST_PROXY_HEADERS=false
# Opt-in backend owner console at /demo/owner; production rejects true. Use an isolated demo database.
RAIL_DEMO_MODE=false
# Required independent private JSON rings; provision as described in docs/DEPLOYMENT.md.
RAIL_EVIDENCE_KEY_RING=
RAIL_RISK_RECORD_KEY_RING=
# Separate keys are required for new agent consent, decisions and spending; human startup remains available without them.
RAIL_AGENT_AUTHORITY_KEY_RING=
# Optional operator-enrolled Ed25519 public keys; private merchant signing keys never belong here.
RAIL_MERCHANT_QUOTE_KEYS=
# Optional passkey ceremony configuration; RP ID must equal the origin hostname.
RAIL_WEBAUTHN_RP_ID=
RAIL_WEBAUTHN_ORIGIN=
# Required for agent proof-enabled HTTP use; omit until a canonical public origin is configured.
# RAIL_AGENT_API_ORIGIN=https://api.your-domain.example
