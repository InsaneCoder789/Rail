DATABASE_URL=postgresql://localhost:5432/YOUR_DATABASE
RAIL_SIGNING_SECRET=SUPERSECRETPASSWD
JWT_SECRET=ANOTHER_SUPERSECRETPASSWD
RAIL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
RAIL_API_KEY_SCOPES=offline_tokens:issue,sync:write
RAIL_TRUST_PROXY_HEADERS=false
# Required independent private JSON rings; provision as described in docs/DEPLOYMENT.md.
RAIL_EVIDENCE_KEY_RING=
RAIL_RISK_RECORD_KEY_RING=
# Separate keys are required for new agent consent, decisions and spending; human startup remains available without them.
RAIL_AGENT_AUTHORITY_KEY_RING=
# Optional operator-enrolled Ed25519 public keys; private merchant signing keys never belong here.
RAIL_MERCHANT_QUOTE_KEYS=
